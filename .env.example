# ---------------------------------------------------------------------------
# HubSpot Print Orders profit calculation service — environment template
# Copy to .env for local runs. Never commit a real token. .env is git-ignored.
# ---------------------------------------------------------------------------

# --- Safety gates ----------------------------------------------------------
# DRY_RUN defaults to true when unset. A verified HubSpot webhook PATCH runs
# only when DRY_RUN=false AND ALLOW_HUBSPOT_WRITES=true AND a token is present.
# Manual requests are deliberately disabled in public production deployments.
DRY_RUN=true
ALLOW_HUBSPOT_WRITES=false

# --- HubSpot credentials (primary, injected by the platform) ---------------
# The service reads these first. Values are never logged or returned by the API.
CUSTOM_CRED_API_HUBAPI_COM_URL=https://api.hubapi.com
CUSTOM_CRED_API_HUBAPI_COM_TOKEN=

# --- HubSpot credentials (fallback, only used if the above are absent) -----
HUBSPOT_API_BASE=https://api.hubapi.com
HUBSPOT_ACCESS_TOKEN=

# --- Webhook signature verification -----------------------------------------
# Set to the private app client secret to enforce signatures. A public
# production endpoint fails closed when this is empty. A secure Computer
# credential can inject the value as
# CUSTOM_CRED_HUBSPOT_WEBHOOK_CLIENT_SECRET_LOCAL_TOKEN instead.
# Supports v1 (X-HubSpot-Signature) and v3 (X-HubSpot-Signature-V3).
HUBSPOT_WEBHOOK_SECRET=

# Optional: SHA-256 hash of a high-entropy callback token added to HubSpot's
# webhook target URL. Leave blank unless you intentionally configure this
# fallback; unsigned deliveries are rejected when it is blank.
HUBSPOT_CALLBACK_TOKEN_SHA256=

# --- v3 signature URI base (optional) --------------------------------------
# v3 signs the full public request URI. Set this when the service runs behind a
# proxy whose Host header differs from the public URL, e.g.
# For this published deployment:
# PUBLIC_BASE_URL=https://print-orders-margin.pplx.app/port/5000
PUBLIC_BASE_URL=

# --- Server ----------------------------------------------------------------
PORT=5000

# --- CTB upload guardrail ---------------------------------------------------
# The service holds one CTB in memory only long enough to extract print
# metadata, then discards the raw file. The default is 512 MB. Use a whole
# number between 64 and 1024 only when the Railway service has adequate memory.
PRINT_FILE_MAX_MB=512

# --- Paid Order Intake ------------------------------------------------------
# The intake page does not create leads. It accepts a pasted, payment-confirmed
# Marketplace conversation, lets you review its suggestions, then creates one
# Contact and one associated Print Orders deal in the Deposit Received stage.
#
# Protect this public write action with a long, unique access code. Set only
# its SHA-256 hash here; never put the plain code in client code, source
# control, or a shared document. Generate the hash with:
# node -e "console.log(require('crypto').createHash('sha256').update('YOUR-CODE').digest('hex'))"
PAID_ORDER_INTAKE_ACCESS_CODE_HASH=

# --- Persistence -------------------------------------------------------------
# On Railway, attach a Volume at /data and set both paths there so pending
# customer submissions survive deploys. This is a single-service pilot setup;
# migrate to Railway Postgres before treating customer history as critical.
ORDER_LINKS_DB_FILE=
AUDIT_LOG_FILE=

# Development-only: keep blank in Railway. Set to true only together with
# NODE_ENV=development or NODE_ENV=test to expose local maintenance endpoints.
ENABLE_INTERNAL_ADMIN=
