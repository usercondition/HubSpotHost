# ---------------------------------------------------------------------------
# HubSpot Print Orders profit calculation service — environment template
# Copy to .env for local runs. Never commit a real token. .env is git-ignored.
# ---------------------------------------------------------------------------

# --- Safety gates ----------------------------------------------------------
# DRY_RUN defaults to true when unset. A verified HubSpot webhook PATCH runs
# only when DRY_RUN=false AND ALLOW_HUBSPOT_WRITES=true AND a token is present.
# Manual requests are deliberately disabled in public production deployments.
DRY_RUN=true
ALLOW_HUBSPOT_WRITES=false

# --- HubSpot credentials (primary, injected by the platform) ---------------
# The service reads these first. Values are never logged or returned by the API.
CUSTOM_CRED_API_HUBAPI_COM_URL=https://api.hubapi.com
CUSTOM_CRED_API_HUBAPI_COM_TOKEN=

# --- HubSpot credentials (fallback, only used if the above are absent) -----
HUBSPOT_API_BASE=https://api.hubapi.com
HUBSPOT_ACCESS_TOKEN=

# --- Webhook signature verification -----------------------------------------
# Set to the private app client secret to enforce signatures. A public
# production endpoint fails closed when this is empty. A secure Computer
# credential can inject the value as
# CUSTOM_CRED_HUBSPOT_WEBHOOK_SECRET_LOCAL_TOKEN instead.
# Supports v1 (X-HubSpot-Signature) and v3 (X-HubSpot-Signature-V3).
HUBSPOT_WEBHOOK_SECRET=

# --- v3 signature URI base (optional) --------------------------------------
# v3 signs the full public request URI. Set this when the service runs behind a
# proxy whose Host header differs from the public URL, e.g.
# PUBLIC_BASE_URL=https://margin-service.example.com
PUBLIC_BASE_URL=

# --- Server ----------------------------------------------------------------
PORT=5000
